# Supabase project settings (Project Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-side only, never expose to the browser.
# Used by app/api/leads/route.ts to insert signups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Community links: update these once you've created the accounts.
# Until then the landing page shows "Coming soon" instead of a broken link.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_GROUP_URL=

# Contact email shown in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@ownerfinancinghalalway.com

# Free offers section: training videos, resources, and Calendly link.
# Same "Coming soon" behavior as the community links above until set.
NEXT_PUBLIC_TRAINING_VIDEOS_URL=
NEXT_PUBLIC_RESOURCES_URL=
NEXT_PUBLIC_CALENDLY_URL=

# Optional override for the mortgage vs. halal financing calculator link.
# Defaults to the deployed aminhas-cre/mortgage-investment-calculator project
# if left blank.
NEXT_PUBLIC_CALCULATOR_URL=
